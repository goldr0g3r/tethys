<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Tethys demo report — {{ scenario.name }}</title>
  <style>
    body { font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; max-width: 960px; margin: 2em auto; padding: 0 1em; color: #1a1a1a; }
    h1 { border-bottom: 2px solid #1a1a1a; padding-bottom: 0.25em; }
    table { border-collapse: collapse; width: 100%; margin-bottom: 1em; }
    th, td { border: 1px solid #ccc; padding: 0.4em 0.6em; text-align: left; vertical-align: top; }
    th { background: #f4f4f4; }
    .ok { color: #1a7f37; }
    .warn { color: #b08800; }
    .err { color: #cf222e; }
    pre { background: #f6f8fa; padding: 0.6em; overflow: auto; }
  </style>
</head>
<body>
  <h1>Tethys demo report</h1>
  <p>
    <strong>Scenario:</strong> {{ scenario.name }} ({{ scenario.profile.value }}) —
    <strong>Duration:</strong> {{ "%.3f"|format(scenario.duration_s) }} s —
    <strong>Plant:</strong> {{ scenario.plant.kind.value }} —
    <strong>Generated:</strong> {{ generated_utc }}
  </p>

  <h2>Run summary</h2>
  <table>
    <tr><th>Master rows written</th><td>{{ master_rows_written }}</td></tr>
    <tr><th>Plant rows read</th><td>{{ plant_rows_read }}</td></tr>
    <tr><th>DAQ dropped (Phase 3+)</th><td class="ok">{{ daq_dropped }}</td></tr>
    <tr><th>CAL CRC failures (Phase 4+)</th><td class="ok">{{ cal_crc_fail }}</td></tr>
    <tr><th>Bridge master timeouts</th><td class="{{ 'warn' if bridge_master_timeouts > 0 else 'ok' }}">{{ bridge_master_timeouts }}</td></tr>
    <tr><th>Dry-run</th><td>{{ "yes" if dry_run else "no" }}</td></tr>
  </table>

  <h2>Standards trace</h2>
  {% if scenario.trace.standards %}
  <table>
    <tr><th>#</th><th>Standard reference</th></tr>
    {% for citation in scenario.trace.standards %}
    <tr><td>{{ loop.index }}</td><td>{{ citation }}</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p><em>No standards declared in scenario.trace.standards.</em></p>
  {% endif %}

  <h2>Scenario JSON</h2>
  <pre>{{ scenario_json }}</pre>
</body>
</html>
