# Root .gitignore - root-level cross-cutting ignores only.
# Per-component ignores live in their own .gitignore files (e.g. slave/.gitignore from cmake-init).

# Python (master + simulator)
.venv/
.uv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# C/C++ build outputs
build/
*.o
*.a
*.obj
*.exe

# Sphinx docs site build artefacts (lands in PR-11a; build via
# `sphinx-build -W -c docs/site -b html docs docs/_build/html`).
# The .venv-docs/ helper venv used for local builds is also ignored.
docs/_build/
docs/site/_build/
.venv-docs/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Ceedling (lands in PR-1a)
.ceedling/

# Local commit-message temp files (used by CI/agent workflows; never committed)
COMMIT_MSG.tmp
PR_BODY.tmp
.git/TETHYS_COMMIT_MSG
.git/TETHYS_PR_BODY
