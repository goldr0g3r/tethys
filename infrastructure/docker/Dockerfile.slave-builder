# syntax=docker/dockerfile:1.7
# Tethys slave C-library build environment.
#
# A single image carrying every tool the slave matrix legs in ci.yml /
# misra-gate.yml / static-analysis.yml / coverage.yml need:
#
#   - GCC + Clang (native host = ubuntu-latest / debian-bookworm)
#   - arm-none-eabi-gcc cross-toolchain (Cortex-M targets: STM32F4/F7/H7)
#   - CMake + Ninja
#   - cppcheck with the MISRA addon
#   - clang-tidy + scan-build + gcovr + lcov
#   - Ruby + Ceedling for Unity-based unit tests
#
# Build from repo root:
#   docker build -t tethys-slave-builder:dev -f infrastructure/docker/Dockerfile.slave-builder .
#
# Run:
#   docker run --rm -v "$PWD:/workspace" tethys-slave-builder:dev \
#       cmake --preset dev -S /workspace/slave -B /workspace/slave/build
#
# Cite: parent plan section 5 (toolchain) + section 6.7 (ci.yml + misra-gate.yml).
# Cite: ADR-0008 (license-free toolchain).
# Cite: MISRA C:2023 (mandatory + required as a hard CI gate, advisory tracked).

FROM debian:bookworm-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Pin tool versions in the apt install set; bookworm's repos already serve
# stable point releases. Phase 11 PR may bind these to digests via Renovate.
ARG CMAKE_MIN_VERSION=3.27.4
ARG GCC_VERSION=12
ARG CLANG_VERSION=14
ARG ARM_NONE_EABI_VERSION=12.2

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        # ---- Host C/C++ toolchain ----
        gcc-${GCC_VERSION} \
        g++-${GCC_VERSION} \
        clang-${CLANG_VERSION} \
        clang-tidy-${CLANG_VERSION} \
        clang-tools-${CLANG_VERSION} \
        # ---- Build orchestration ----
        cmake \
        ninja-build \
        make \
        pkg-config \
        # ---- Embedded cross-toolchain ----
        gcc-arm-none-eabi \
        binutils-arm-none-eabi \
        libnewlib-arm-none-eabi \
        # ---- Static analysis + coverage ----
        cppcheck \
        gcovr \
        lcov \
        # ---- Unity + Ceedling ----
        ruby \
        ruby-dev \
        rubygems-integration \
        # ---- Misc ----
        git \
        ca-certificates \
        curl \
        python3 \
        python3-pip \
        # ---- Codespell + yamllint (pre-commit parity) ----
        codespell \
        yamllint \
 && rm -rf /var/lib/apt/lists/* \
 && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-${GCC_VERSION} 100 \
 && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-${GCC_VERSION} 100 \
 && update-alternatives --install /usr/bin/clang clang /usr/bin/clang-${CLANG_VERSION} 100 \
 && update-alternatives --install /usr/bin/clang-tidy clang-tidy /usr/bin/clang-tidy-${CLANG_VERSION} 100 \
 && update-alternatives --install /usr/bin/scan-build scan-build /usr/bin/scan-build-${CLANG_VERSION} 100

# Ceedling - latest stable line. Pinned per version-pinning.mdc.
ARG CEEDLING_VERSION=0.31.1
RUN gem install --no-document ceedling -v "${CEEDLING_VERSION}"

# cppcheck MISRA addon: ships in the cppcheck source tree but Debian's
# package does not bundle the rule text (which MISRA requires user-supplied
# per the licence). Map the in-repo cache at /workspace/docs/misra-c-2023-rules.txt
# into the cppcheck addon at run time:
#   docker run -v "$PWD:/workspace" tethys-slave-builder:dev \
#       cppcheck --addon=misra --rule-texts=/workspace/docs/misra-c-2023-rules.txt slave/src/...

WORKDIR /workspace

# Non-root user mirrors the master/sim images.
RUN useradd --create-home --shell /bin/bash tethys
USER tethys
WORKDIR /home/tethys

ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["echo 'tethys-slave-builder image - mount your workspace at /workspace and invoke cmake / cppcheck / ceedling'; exec /bin/bash"]

LABEL org.opencontainers.image.title="tethys-slave-builder" \
      org.opencontainers.image.description="Tethys slave C-library build environment: gcc + clang + arm-none-eabi + cmake + cppcheck + clang-tidy + ceedling." \
      org.opencontainers.image.source="https://github.com/goldr0g3r/tethys" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.documentation="https://github.com/goldr0g3r/tethys/blob/main/infrastructure/docker/README.md"
